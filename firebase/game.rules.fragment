    // Fire Defense — employee-only game. Insert inside the existing documents match.
    // Uses the hub's existing signedIn() helper (which excludes anonymous accounts).
    function fdApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['new','tech','temp','manager','admin'];
    }
    function fdProfileValid(d) {
      return d.keys().hasAll(['credits','nozzle','foam','cannon','revision','nickname','lastSaveId','updatedAt'])
        && d.keys().hasOnly(['credits','nozzle','foam','cannon','revision','nickname','lastSaveId','updatedAt'])
        && d.credits is int && d.credits >= 0 && d.credits <= 1000000
        && d.nozzle is int && d.nozzle >= 0 && d.nozzle <= 5
        && d.foam is int && d.foam >= 0 && d.foam <= 3
        && d.cannon is int && d.cannon >= 0 && d.cannon <= 3
        && d.revision is int && d.revision >= 0 && d.revision <= 2147483647
        && d.nickname is string && d.nickname.matches('^[A-Za-z0-9 _.-]{3,16}$')
        && d.lastSaveId is string && (d.lastSaveId == '' || d.lastSaveId.matches('^[a-f0-9]{32}$'))
        && d.updatedAt == request.time;
    }
    match /fdGameProfiles/{uid} {
      allow get: if fdApproved() && request.auth.uid == uid;
      allow list: if false;
      allow create: if fdApproved() && request.auth.uid == uid
        && fdProfileValid(request.resource.data)
        && request.resource.data.credits == 0 && request.resource.data.nozzle == 0
        && request.resource.data.foam == 0 && request.resource.data.cannon == 0
        && request.resource.data.revision == 0 && request.resource.data.lastSaveId == '';
      allow update: if fdApproved() && request.auth.uid == uid
        && fdProfileValid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.nickname == resource.data.nickname
        && request.resource.data.lastSaveId != ''
        && request.resource.data.nozzle >= resource.data.nozzle
        && request.resource.data.foam >= resource.data.foam
        && request.resource.data.cannon >= resource.data.cannon;
      allow delete: if false;
    }
    function fdRunValid(d, uid) {
      return d.keys().hasAll(['nickname','room','score','elapsedMs','updatedAt'])
        && d.keys().hasOnly(['nickname','room','score','elapsedMs','updatedAt'])
        && d.nickname is string && d.nickname.matches('^[A-Za-z0-9 _.-]{3,16}$')
        && d.nickname == getAfter(/databases/$(database)/documents/fdGameProfiles/$(uid)).data.nickname
        && d.room is int && d.room >= 1 && d.room <= 30
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.elapsedMs is int && d.elapsedMs >= 1 && d.elapsedMs <= 86400000
        && d.updatedAt == request.time;
    }
    function fdBetter(n, old) {
      return n.room > old.room || (n.room == old.room &&
        (n.score > old.score || (n.score == old.score && n.elapsedMs < old.elapsedMs)));
    }
    match /fdGameLeaderboard/{uid} {
      allow get: if fdApproved();
      allow list: if fdApproved() && request.query.limit != null && request.query.limit <= 20;
      allow create: if fdApproved() && request.auth.uid == uid && fdRunValid(request.resource.data, uid);
      allow update: if fdApproved() && request.auth.uid == uid
        && fdRunValid(request.resource.data, uid) && fdBetter(request.resource.data, resource.data);
      allow delete: if false;
    }
