rules_version = '2';

// FDEC Quick Hub — unified Firestore rules for project: fire-defense-itm-reports
// Replace this project's existing rules with these (they cover the ITM reports,
// Time-Off requests, the shared users list, and the Administration config).
//
// Model:
//   users/{uid}         { email, name, role: new|tech|manager|admin, status: pending|approved|denied, balances? }
//   config/permissions  { pages: { <pageId>: [roles allowed] } }
//   requests/{id}       Time-Off requests  { uid, name, status, ... }
//   reports/{id}        ITM inspection reports
//
// A user may create only their OWN profile and may never grant themselves a
// manager/admin role or an approved status. Admins (by email or by role) manage
// everyone. Managers may edit roster balances but not roles or account status.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(){ return request.auth != null; }
    function email(){ return request.auth.token.email; }
    function isAdminEmail(){
      return signedIn() && email() in [
        'mp1@firedefense.com', '302stang86@gmail.com', 'wh1@firedefense.com'
      ];
    }
    function myRole(){
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'new';
    }
    function isAdmin(){ return isAdminEmail() || (signedIn() && myRole() == 'admin'); }
    function isManager(){ return signedIn() && myRole() == 'manager'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isManager());

      // Self sign-up: own doc only, no self-granted manager/admin or approved.
      allow create: if (signedIn() && request.auth.uid == uid
                        && (!('role'   in request.resource.data) || request.resource.data.role   in ['new','tech'])
                        && (!('status' in request.resource.data) || request.resource.data.status == 'pending'))
                    || (isAdminEmail() && request.auth.uid == uid);

      // Admins change anything. Managers may approve/deny/archive and set a
      // user's role to new/tech/manager, but may not touch an admin account or
      // grant the admin role. The user themselves may edit other fields
      // (e.g. name, balances) but never their own role or account status.
      allow update: if isAdmin()
                    || (isManager()
                        && resource.data.role != 'admin'
                        && request.resource.data.role in ['new','tech','temp','manager'])
                    || (request.auth.uid == uid
                        && request.resource.data.role   == resource.data.role
                        && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // Fleet mailto recipient directory (names + business email addresses only).
    // All approved employees can GET this one document; only admin/manager can edit.
    // Do not place private employee profiles or other user data in this document.
    match /config/fleetRecipients {
      allow get: if signedIn() && (isAdmin() || isManager() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'));
      allow list: if false;
      allow create, update, delete: if isAdmin() || isManager();
    }

    match /config/permissions {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Shared on-call rotation schedule: everyone signed in reads it live;
    // admins and managers publish changes.
    match /config/oncall {
      allow read:  if signedIn();
      allow write: if isAdmin() || isManager();
    }

    // Announcement marquee shown on the Quick Hub home page. Every signed-in user
    // reads it (to display the scrolling bar); only admins turn it on/off and edit.
    match /config/marquee {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Shared Quoting master material price list: signed-in users read it;
    // admins and managers (who are the only ones with the Quoting page) save it.
    match /config/materialCatalog {
      allow read:  if signedIn();
      allow write: if isAdmin() || isManager();
    }

    // Shared Quoting master equipment fees list: signed-in users read it;
    // admins and managers save it.
    match /config/equipmentFees {
      allow read:  if signedIn();
      allow write: if isAdmin() || isManager();
    }

    // Fire Alarm Quoting master rates (hourly rates, truck/IROL fees, mileage,
    // per diem, materials, level labels). Signed-in users read them; admins and
    // managers save them.
    match /config/faQuoteRates {
      allow read:  if signedIn();
      allow write: if isAdmin() || isManager();
    }

    // Announcements — everyone signed in reads; admins and managers post/edit/delete.
    match /announcements/{id} {
      allow read:                if signedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Time-Off requests
    match /requests/{id} {
      allow read:   if isAdmin() || isManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || isManager()
                            || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ITM inspection reports (adjust if your ITM app needs per-owner editing)
    match /reports/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin()
                            || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Quote files — drafts, Word docs, and export packages saved from the
    // Quoting & Proposal Suite. Stored entirely in Firestore (no paid Cloud
    // Storage): each record holds the searchable metadata (jobName, quoteNo,
    // userName), and the file bytes live in a "chunks" subcollection beneath it.
    // A user creates only their own entries; admins and managers see everyone's.
    match /quoteFiles/{id} {
      allow read:   if isAdmin() || isManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || isManager()
                            || (signedIn() && resource.data.uid == request.auth.uid);

      // File body, split into base64 chunks. Each chunk carries its owner uid.
      // Admins/managers may also write chunks when replacing an edited quote.
      match /chunks/{cid} {
        allow read:   if isAdmin() || isManager() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if isAdmin() || isManager() || (signedIn() && request.resource.data.uid == request.auth.uid);
        allow update, delete: if isAdmin() || isManager()
                              || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Password reset requests — filed from the sign-in screen while the user is
    // signed OUT (they forgot their password), then approved or denied by an
    // admin/manager who emails the reset link. Anyone may file a pending request
    // (email only); only managers/admins read and resolve them.
    match /passwordResets/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin() || isManager();
    }

    // Everything else: denied.
    // Shared inventory catalog: categories, subcategories, items, and the
    // recommended quantities. Every signed-in user reads it; admins and
    // managers edit the structure and recommended values.
    match /config/inventoryCatalog {
      allow read:  if signedIn();
      allow write: if isAdmin() || isManager();
    }

    // Per-technician On Hand sheets. Each tech reads and writes only their
    // OWN vehicle counts (document id == their uid). Admins and managers may
    // read and edit any tech's sheet.
    match /inventoryOnHand/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isAdmin() || isManager());
      allow create, update, delete:
                    if signedIn() && (request.auth.uid == uid || isAdmin() || isManager());
    }

    // Weekly time sheets. A technician reads and writes only their OWN sheets
    // (employeeUid == their uid); admins and managers may read and edit any sheet
    // for review. Create is allowed when the new sheet is the user's own, or by an
    // admin/manager.
    match /timesheets/{id} {
      allow read:   if signedIn() && (isAdmin() || isManager() || resource.data.employeeUid == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || isManager() || request.resource.data.employeeUid == request.auth.uid);
      allow update: if signedIn() && (isAdmin() || isManager() || resource.data.employeeUid == request.auth.uid);
      // A technician may discard their own draft, but not a submitted/reviewed sheet.
      // Only manager/admin may delete a submitted or reviewed payroll record.
      allow delete: if signedIn() && (isAdmin() || isManager() ||
                     (resource.data.employeeUid == request.auth.uid && resource.data.status == 'draft'));
    }

    // Fleet: all signed-in approved employees (and admin email overrides) may submit.
    // Technicians NEVER read any fleet report documents. Only manager/admin can view them.
    // Submitters can update ONLY the PDF upload status/path for their newly created report.
    function fleetSubmitter(){
      return signedIn() && (isAdminEmail() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      ));
    }
    match /fleetServiceReports/{reportId} {
      allow get, list: if isAdmin() || isManager();
      // Submit saves a dashboard record (email is sent client-side via mailto).
      allow create: if fleetSubmitter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if isAdmin() || isManager();
      // Admins delete anything; managers may delete only archived records
      // (the dashboard purges archived records older than 30 days).
      allow delete: if isAdmin() || (isManager() && resource.data.archived == true);
    }

    // Fleet vehicle assignments. A technician reads only their OWN assigned
    // vehicle (document id == their uid). Admins and managers read all and
    // assign or edit any technician's vehicle.
    match /fleetAssets/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isAdmin() || isManager());
      allow create, update, delete: if isAdmin() || isManager();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
